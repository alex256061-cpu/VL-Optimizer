<Project>
  <!-- Native probe loaded by the VL injector. Plain MSBuild project (not an SDK project) so the
       solution builds on machines without the managed SDK. The native compile runs only when a C++
       toolchain is present; set VLOptimizerSkipNativeStub=true to force-skip. -->
  <PropertyGroup>
    <!-- Not an SDK project: opt out of NuGet restore so the solution restore does not warn (NU1503). -->
    <MSBuildProjectExtensionsPath>$(MSBuildThisFileDirectory)obj\</MSBuildProjectExtensionsPath>
    <RestoreProjectStyle>None</RestoreProjectStyle>
    <VLOptimizerStubDir>$(MSBuildThisFileDirectory)</VLOptimizerStubDir>
    <VLOptimizerStubOut>$(MSBuildThisFileDirectory)..\..\artifacts\private\engine-stub</VLOptimizerStubOut>
    <VLOptimizerVcVars Condition="'$(VLOptimizerVcVars)' == '' and Exists('C:\Program\VC\Auxiliary\Build\vcvars64.bat')">C:\Program\VC\Auxiliary\Build\vcvars64.bat</VLOptimizerVcVars>
    <VLOptimizerStubEnabled Condition="'$(VLOptimizerSkipNativeStub)' == 'true'">false</VLOptimizerStubEnabled>
    <VLOptimizerStubEnabled Condition="'$(VLOptimizerStubEnabled)' == '' and Exists('$(VLOptimizerVcVars)')">true</VLOptimizerStubEnabled>
    <VLOptimizerStubEnabled Condition="'$(VLOptimizerStubEnabled)' == ''">false</VLOptimizerStubEnabled>
  </PropertyGroup>

  <Target Name="Build" DependsOnTargets="EngineProbe" />
  <Target Name="Rebuild" DependsOnTargets="Clean;EngineProbe" />
  <Target Name="Clean">
    <Delete Files="$(VLOptimizerStubOut)\VL.EngineProbe.dll" />
  </Target>

  <Target Name="EngineProbe">
    <Message Importance="high" Text="Native engine probe skipped: no C++ toolchain found." Condition="'$(VLOptimizerStubEnabled)' != 'true'" />
    <CallTarget Targets="CompileEngineProbe" Condition="'$(VLOptimizerStubEnabled)' == 'true'" />
  </Target>

  <Target Name="CompileEngineProbe">
    <MakeDir Directories="$(VLOptimizerStubOut)" />
    <Message Importance="high" Text="Building native engine probe -&gt; $(VLOptimizerStubOut)\VL.EngineProbe.dll" />
    <Exec Command="&quot;$(VLOptimizerStubDir)build-stub.bat&quot;" WorkingDirectory="$(VLOptimizerStubDir)" StandardOutputImportance="high" StandardErrorImportance="high" />
    <Error Condition="!Exists('$(VLOptimizerStubOut)\VL.EngineProbe.dll')" Text="Native probe build produced no DLL." />
  </Target>
</Project>
