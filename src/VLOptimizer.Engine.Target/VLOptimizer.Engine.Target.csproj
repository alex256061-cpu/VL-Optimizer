<Project>
  <!-- Synthetic D3D11 render target used to validate scaling end to end on a controlled, disposable
       window instead of a protected game. Same toolchain rule as the other native pieces. -->
  <PropertyGroup>
    <VLOptimizerTargetDir>$(MSBuildThisFileDirectory)</VLOptimizerTargetDir>
    <VLOptimizerTargetOut>$(MSBuildThisFileDirectory)..\..\artifacts\private\engine-target</VLOptimizerTargetOut>
    <VLOptimizerVcVars Condition="'$(VLOptimizerVcVars)' == '' and Exists('C:\Program\VC\Auxiliary\Build\vcvars64.bat')">C:\Program\VC\Auxiliary\Build\vcvars64.bat</VLOptimizerVcVars>
    <VLOptimizerTargetEnabled Condition="'$(VLOptimizerSkipNativeStub)' == 'true'">false</VLOptimizerTargetEnabled>
    <VLOptimizerTargetEnabled Condition="'$(VLOptimizerTargetEnabled)' == '' and Exists('$(VLOptimizerVcVars)')">true</VLOptimizerTargetEnabled>
    <VLOptimizerTargetEnabled Condition="'$(VLOptimizerTargetEnabled)' == ''">false</VLOptimizerTargetEnabled>
  </PropertyGroup>

  <Target Name="Build" DependsOnTargets="RenderTarget" />
  <Target Name="Rebuild" DependsOnTargets="Clean;RenderTarget" />
  <Target Name="Clean">
    <Delete Files="$(VLOptimizerTargetOut)\VLRenderTarget.exe" />
  </Target>

  <Target Name="RenderTarget">
    <Message Importance="high" Text="Synthetic render target skipped: no C++ toolchain found." Condition="'$(VLOptimizerTargetEnabled)' != 'true'" />
    <CallTarget Targets="CompileRenderTarget" Condition="'$(VLOptimizerTargetEnabled)' == 'true'" />
  </Target>

  <Target Name="CompileRenderTarget">
    <MakeDir Directories="$(VLOptimizerTargetOut)" />
    <Message Importance="high" Text="Building synthetic render target -&gt; $(VLOptimizerTargetOut)\VLRenderTarget.exe" />
    <Exec Command="&quot;$(VLOptimizerTargetDir)build-target.bat&quot; &quot;$(VLOptimizerTargetOut)&quot;" WorkingDirectory="$(VLOptimizerTargetDir)" StandardOutputImportance="high" StandardErrorImportance="high" />
    <Error Condition="!Exists('$(VLOptimizerTargetOut)\VLRenderTarget.exe')" Text="Render target build produced no EXE." />
  </Target>
</Project>
