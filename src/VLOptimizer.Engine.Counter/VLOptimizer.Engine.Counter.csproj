<Project>
  <!-- DXGI frame counter: measures the real present rate without elevation (PresentMon needs an ETW
       session, which requires admin). Same toolchain rule as the other native pieces. -->
  <PropertyGroup>
    <VLOptimizerCounterDir>$(MSBuildThisFileDirectory)</VLOptimizerCounterDir>
    <VLOptimizerCounterOut>$(MSBuildThisFileDirectory)..\..\artifacts\private\engine-counter</VLOptimizerCounterOut>
    <VLOptimizerVcVars Condition="'$(VLOptimizerVcVars)' == '' and Exists('C:\Program\VC\Auxiliary\Build\vcvars64.bat')">C:\Program\VC\Auxiliary\Build\vcvars64.bat</VLOptimizerVcVars>
    <VLOptimizerCounterEnabled Condition="'$(VLOptimizerSkipNativeStub)' == 'true'">false</VLOptimizerCounterEnabled>
    <VLOptimizerCounterEnabled Condition="'$(VLOptimizerCounterEnabled)' == '' and Exists('$(VLOptimizerVcVars)')">true</VLOptimizerCounterEnabled>
    <VLOptimizerCounterEnabled Condition="'$(VLOptimizerCounterEnabled)' == ''">false</VLOptimizerCounterEnabled>
  </PropertyGroup>

  <Target Name="Build" DependsOnTargets="FrameCounter" />
  <Target Name="Rebuild" DependsOnTargets="Clean;FrameCounter" />
  <Target Name="Clean">
    <Delete Files="$(VLOptimizerCounterOut)\VLFrameCounter.exe" />
  </Target>

  <Target Name="FrameCounter">
    <Message Importance="high" Text="Frame counter skipped: no C++ toolchain found." Condition="'$(VLOptimizerCounterEnabled)' != 'true'" />
    <CallTarget Targets="CompileFrameCounter" Condition="'$(VLOptimizerCounterEnabled)' == 'true'" />
  </Target>

  <Target Name="CompileFrameCounter">
    <MakeDir Directories="$(VLOptimizerCounterOut)" />
    <Message Importance="high" Text="Building frame counter -&gt; $(VLOptimizerCounterOut)\VLFrameCounter.exe" />
    <Exec Command="&quot;$(VLOptimizerCounterDir)build-counter.bat&quot; &quot;$(VLOptimizerCounterOut)&quot;" WorkingDirectory="$(VLOptimizerCounterDir)" StandardOutputImportance="high" StandardErrorImportance="high" />
    <Error Condition="!Exists('$(VLOptimizerCounterOut)\VLFrameCounter.exe')" Text="Frame counter build produced no EXE." />
  </Target>
</Project>
