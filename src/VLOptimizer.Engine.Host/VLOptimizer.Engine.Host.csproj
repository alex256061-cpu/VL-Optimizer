<Project>
  <!-- Test host that loads the real engine so the probe can be injected into a disposable process.
       Same toolchain rule as the stub: skipped when no C++ compiler is available. -->
  <PropertyGroup>
    <VLOptimizerHostDir>$(MSBuildThisFileDirectory)</VLOptimizerHostDir>
    <VLOptimizerHostOut>$(MSBuildThisFileDirectory)..\..\artifacts\private\engine-host</VLOptimizerHostOut>
    <VLOptimizerVcVars Condition="'$(VLOptimizerVcVars)' == '' and Exists('C:\Program\VC\Auxiliary\Build\vcvars64.bat')">C:\Program\VC\Auxiliary\Build\vcvars64.bat</VLOptimizerVcVars>
    <VLOptimizerHostEnabled Condition="'$(VLOptimizerSkipNativeStub)' == 'true'">false</VLOptimizerHostEnabled>
    <VLOptimizerHostEnabled Condition="'$(VLOptimizerHostEnabled)' == '' and Exists('$(VLOptimizerVcVars)')">true</VLOptimizerHostEnabled>
    <VLOptimizerHostEnabled Condition="'$(VLOptimizerHostEnabled)' == ''">false</VLOptimizerHostEnabled>
  </PropertyGroup>

  <Target Name="Build" DependsOnTargets="EngineHost" />
  <Target Name="Rebuild" DependsOnTargets="Clean;EngineHost" />
  <Target Name="Clean">
    <Delete Files="$(VLOptimizerHostOut)\VLEngineHost.exe" />
  </Target>

  <Target Name="EngineHost">
    <Message Importance="high" Text="Native engine host skipped: no C++ toolchain found." Condition="'$(VLOptimizerHostEnabled)' != 'true'" />
    <CallTarget Targets="CompileEngineHost" Condition="'$(VLOptimizerHostEnabled)' == 'true'" />
  </Target>

  <Target Name="CompileEngineHost">
    <MakeDir Directories="$(VLOptimizerHostOut)" />
    <Message Importance="high" Text="Building native engine host -&gt; $(VLOptimizerHostOut)\VLEngineHost.exe" />
    <Exec Command="&quot;$(VLOptimizerHostDir)build-host.bat&quot;" WorkingDirectory="$(VLOptimizerHostDir)" StandardOutputImportance="high" StandardErrorImportance="high" />
    <Error Condition="!Exists('$(VLOptimizerHostOut)\VLEngineHost.exe')" Text="Native host build produced no EXE." />
  </Target>
</Project>
